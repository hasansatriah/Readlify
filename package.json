{
  "name": "readlify",
  "version": "1.1.2",
  "description": "Cozy, Apple-style, ADHD-friendly desktop companion for kuliah — pomodoro, tugas, daftar pustaka, dan EdPDF (pembaca PDF jurnal).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "build": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "author": "@hasansatriah",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "id.hasan.readlify",
    "productName": "Readlify",
    "copyright": "Copyright © 2026 Hasan",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Readlify",
      "uninstallDisplayName": "Readlify",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Readlify-Setup-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Dokumen PDF",
        "description": "Dokumen PDF",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  }
}
